def get_coc_player(player_tag):
    url = f"https://api.clashofclans.com/v1/players/{player_tag.replace('#', '%23')}"
    headers = {"Authorization": f"Bearer {COC_API_TOKEN}"}
    response = requests.get(url, headers=headers)
    if response.status_code == 200:
        return response.json()
    return None

@wbot.on_message(filters.command("player2"))
async def player_info(client, message):
    if len(message.command) < 2:
        await message.reply("Usage: /player #<player_tag>")
        return
    player_tag = message.command[1]
    data = get_coc_player(player_tag)
    if data:
        name = data.get("name")
        level = data.get("expLevel")
        trophies = data.get("trophies")
        clan = data.get("clan", {}).get("name", "No Clan")
        await message.reply(f"Player: {name}\nLevel: {level}\nTrophies: {trophies}\nClan: {clan}")
    else:
        await message.reply("Player not found or API error.")

