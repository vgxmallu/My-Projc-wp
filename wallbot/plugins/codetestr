#!/usr/bin/env python3
"""
Coding Practice Bot (Pyrogram + MongoDB)

Features:
- Problems stored in MongoDB (type: "mcq" or "code")
- /practice -> gives a random problem for the chat/user
- MCQ problems: answer via inline buttons, immediate feedback & XP
- Code problems: user replies with /submitcode (reply to problem message) and their code; submission stored for admin review
- Admins can add problems via /addmcq or /addcode in private chat with the bot
- Admins review submissions with /pending (accept/reject). Accepting awards XP and marks solved.
- /profile shows user stats; /leaderboard shows top users by XP
- Safety: bot does NOT execute user code (manual review required)
"""

import os
import asyncio
import logging
import json
from typing import Optional, List, Dict, Any
from datetime import datetime

from dotenv import load_dotenv
from pyrogram import Client, filters
from pyrogram.types import (
    Message,
    InlineKeyboardMarkup,
    InlineKeyboardButton,
    CallbackQuery,
)
from motor.motor_asyncio import AsyncIOMotorClient
from bson.objectid import ObjectId

load_dotenv()

# ---------- Config ----------
API_ID = int(os.getenv("API_ID", "0"))
API_HASH = os.getenv("API_HASH", "")
BOT_TOKEN = os.getenv("BOT_TOKEN", "")
MONGO_URL = os.getenv("MONGO_URL", "mongodb://localhost:27017")
DB_NAME = os.getenv("DB_NAME", "coding_bot_db")
ADMIN_IDS = [int(x) for x in os.getenv("ADMIN_IDS", "").split(",") if x.strip()]

if not (API_ID and API_HASH and BOT_TOKEN):
    raise SystemExit("Set API_ID, API_HASH, BOT_TOKEN in .env")

# ---------- Init ----------
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("CodingPracticeBot")

app = Client("coding_practice_bot", api_id=API_ID, api_hash=API_HASH, bot_token=BOT_TOKEN)
mongo = AsyncIOMotorClient(MONGO_URL)
db = mongo[DB_NAME]

# Collections
problems_col = db["problems"]       # problems: { type: "mcq"|"code", title, statement, choices (for mcq), answer (index), xp, tags, created_by, created_at }
users_col = db["users"]             # users: { user_id, name, xp, solved: [problem_id], submissions_count }
subs_col = db["submissions"]        # submissions: { user_id, problem_id, code, status: pending/accepted/rejected, reviewer, reason, created_at }
meta_col = db["meta"]               # misc

# ---------- Helpers ----------
async def ensure_user(user_id: int, name: str):
    user = await users_col.find_one({"user_id": user_id})
    if not user:
        user = {
            "user_id": user_id,
            "name": name,
            "xp": 0,
            "solved": [],
            "submissions_count": 0,
            "created_at": datetime.utcnow(),
        }
        await users_col.insert_one(user)
    return user

async def award_xp(user_id: int, xp: int, problem_id: str):
    await users_col.update_one({"user_id": user_id}, {"$inc": {"xp": xp}, "$push": {"solved": problem_id}})
    return await users_col.find_one({"user_id": user_id})

def mcq_keyboard(problem_id: str, choices: List[str]):
    kb = []
    for i, c in enumerate(choices):
        kb.append([InlineKeyboardButton(f"{i+1}. {c}", callback_data=f"mcq_answer|{problem_id}|{i}")])
    kb.append([InlineKeyboardButton("⏭ Next", callback_data=f"next|{problem_id}")])
    return InlineKeyboardMarkup(kb)

def code_problem_keyboard(problem_id: str):
    kb = [
        [InlineKeyboardButton("Submit Code (reply to problem) /submitcode", callback_data=f"hint_submit|{problem_id}")],
        [InlineKeyboardButton("⏭ Next", callback_data=f"next|{problem_id}")]
    ]
    return InlineKeyboardMarkup(kb)

async def random_problem(filter_tag: Optional[str] = None):
    # fetch random problem optionally filtered by tag
    query = {}
    if filter_tag:
        query["tags"] = filter_tag
    count = await problems_col.count_documents(query)
    if count == 0:
        return None
    skip = int(os.urandom(2).hex(), 16) % count  # random skip
    cursor = problems_col.find(query).skip(skip).limit(1)
    doc = await cursor.to_list(length=1)
    return doc[0] if doc else None

# ---------- Command Handlers ----------
@app.on_message(filters.command("start"))
async def cmd_start(_, m: Message):
    await ensure_user(m.from_user.id, m.from_user.first_name or m.from_user.username or str(m.from_user.id))
    await m.reply_text(
        "👋 Welcome to Coding Practice Bot!\n\n"
        "Use /practice to get a problem.\n"
        "Use /profile to view your XP and solved problems.\n"
        "Admins: use /addmcq and /addcode to add problems.\n"
        "Important: The bot **does not run your code** for safety. Code submissions require admin review."
    )

@app.on_message(filters.command("practice"))
async def cmd_practice(_, m: Message):
    await ensure_user(m.from_user.id, m.from_user.first_name or m.from_user.username or str(m.from_user.id))
    # optional tag after command: /practice python
    tag = None
    if len(m.command) >= 2:
        tag = m.command[1]
    p = await random_problem(tag)
    if not p:
        await m.reply_text("No problems found. Admins can add problems using /addmcq or /addcode.")
        return
    # save last served problem in meta for reply handling (per chat)
    await meta_col.update_one({"_id": "last_served"}, {"$set": {str(m.chat.id): str(p["_id"])}}, upsert=True)
    # send differently for mcq/code
    if p["type"] == "mcq":
        text = f"*{p.get('title','MCQ Problem')}*\n\n{p.get('statement')}\n\nXP: {p.get('xp',50)}\nTags: {', '.join(p.get('tags',[]))}"
        await m.reply_text(text, reply_markup=mcq_keyboard(str(p["_id"]), p["choices"]), parse_mode="markdown")
    else:
        text = f"*{p.get('title','Coding Problem')}*\n\n{p.get('statement')}\n\n*Input/Output:* {p.get('io','See statement')}\n\nXP: {p.get('xp',100)}\nTags: {', '.join(p.get('tags',[]))}\n\nTo submit your solution: reply to this message with `/submitcode` followed by your code (or reply and send code then `/submitcode`)."
        await m.reply_text(text, reply_markup=code_problem_keyboard(str(p["_id"])), parse_mode="markdown")

