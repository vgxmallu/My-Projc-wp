# ---------- Submission Flow ----------
@app.on_message(filters.command("submitcode"))
async def cmd_submitcode(_, m: Message):
    """
    Users should reply to the problem message with their code, then send /submitcode.
    The bot stores the submission as pending for admin review. No code execution.
    """
    if not m.reply_to_message:
        return await m.reply_text("Reply to the problem message with your code and then send /submitcode.")
    # find last served problem id for this chat (we try to detect)
    last_served = await meta_col.find_one({"_id": "last_served"})
    problem_id = None
    if last_served and str(m.chat.id) in last_served:
        problem_id = last_served[str(m.chat.id)]
    # Alternatively, check if reply_to_message has text that contains "Problem" and attempt to parse id from attached meta (not guaranteed)
    if not problem_id:
        # fallback: ask user to include problem id
        return await m.reply_text("Could not detect problem. Please include problem id in your submission message like: `#problem:<id>` or use /practice then reply to that problem message.")
    # get problem
    try:
        prob = await problems_col.find_one({"_id": ObjectId(problem_id)})
    except Exception:
        prob = None
    if not prob:
        return await m.reply_text("Problem not found (maybe expired). Please /practice again and reply to that message with /submitcode.")
    # get code from reply message - prefer the replied message text if that message is code, else use the current message text after command
    code_text = None
    if m.reply_to_message.text and len(m.reply_to_message.text) > 0:
        code_text = m.reply_to_message.text
    else:
        # use message after command (text following /submitcode)
        if len(m.command) >= 2:
            code_text = " ".join(m.command[1:])
    if not code_text:
        return await m.reply_text("No code detected. Reply to your code message or include code after /submitcode.")
    # store submission
    sub_doc = {
        "user_id": m.from_user.id,
        "user_name": m.from_user.first_name or m.from_user.username or str(m.from_user.id),
        "problem_id": str(prob["_id"]),
        "problem_title": prob.get("title"),
        "code": code_text,
        "status": "pending",
        "reviewer": None,
        "review_note": None,
        "created_at": datetime.utcnow()
    }
    res = await subs_col.insert_one(sub_doc)
    await users_col.update_one({"user_id": m.from_user.id}, {"$inc": {"submissions_count": 1}}, upsert=True)
    await m.reply_text("✅ Submission received and marked *pending*. An admin will review it soon.", parse_mode="markdown")
    # notify admins (best-effort)
    for aid in ADMIN_IDS:
        try:
            await app.send_message(aid, f"🆕 New submission #{res.inserted_id} by {sub_doc['user_name']} for `{prob.get('title')}`. Use /review to manage.")
        except Exception:
            pass

# ---------- Admin: add MCQ ----------
@app.on_message(filters.command("addmcq") & filters.user(ADMIN_IDS))
async def cmd_addmcq(_, m: Message):
    """
    Usage (in private chat with bot):
    /addmcq
    Title: Two Sum
    Statement: Given...
    Choices:
    a) ...
    b) ...
    c) ...
    d) ...
    Answer: b
    XP: 50
    Tags: arrays, easy
    """
    if not m.reply_to_message:
        await m.reply_text("Reply to a message containing the problem spec in the format described in help.")
        return
    text = m.reply_to_message.text or m.text
    # naive parser: read lines
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    data = {"type": "mcq", "choices": [], "tags": [], "created_at": datetime.utcnow(), "created_by": m.from_user.id}
    for line in lines:
        if line.lower().startswith("title:"):
            data["title"] = line.split(":",1)[1].strip()
        elif line.lower().startswith("statement:"):
            data["statement"] = line.split(":",1)[1].strip()
        elif line.lower().startswith("choices:"):
            # following lines until Answer:
            continue
        elif line.lower().startswith("answer:"):
            ans = line.split(":",1)[1].strip().lower()
            # map a/b/c/d to index
            if ans and ans[0] in "abcd":
                data["answer"] = ord(ans[0]) - ord("a")
            else:
                try:
                    data["answer"] = int(ans) - 1
                except:
                    data["answer"] = 0
        elif line.lower().startswith("xp:"):
            try:
                data["xp"] = int(line.split(":",1)[1].strip())
            except:
                data["xp"] = 50
        elif line.lower().startswith("tags:"):
            data["tags"] = [t.strip() for t in line.split(":",1)[1].split(",") if t.strip()]
        elif line and (line[0].lower() in "abcd") and (")" in line or ". " in line):
            # e.g. "a) option text"
            # split after a) or a.
            parts = line.split(")",1) if ")" in line else line.split(".",1)
            if len(parts) >= 2:
                data["choices"].append(parts[1].strip())
        else:
            # append to statement if already have statement
            if "statement" in data and not line.lower().startswith(("choices","answer","xp","tags")):
                data["statement"] += " " + line
    if not data.get("title") or not data.get("statement") or len(data["choices"]) < 2:
        return await m.reply_text("Failed to parse problem. Please follow the format. Example in /help.")
    await problems_col.insert_one(data)
    await m.reply_text("✅ MCQ problem added successfully.")

