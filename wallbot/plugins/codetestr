# ---------- Callback handlers for MCQ & review ----------
@app.on_callback_query(filters.regex(r"^mcq_answer\|"))
async def cb_mcq_answer(_, cq: CallbackQuery):
    try:
        _, pid, idx_s = cq.data.split("|")
        idx = int(idx_s)
    except:
        return await cq.answer("Invalid data", show_alert=True)
    # fetch problem
    prob = await problems_col.find_one({"_id": ObjectId(pid)})
    if not prob:
        return await cq.answer("Problem not found", show_alert=True)
    correct = prob.get("answer", 0)
    if idx == correct:
        # award xp and mark solved if not already solved
        await ensure_user(cq.from_user.id, cq.from_user.first_name or cq.from_user.username or str(cq.from_user.id))
        user = await users_col.find_one({"user_id": cq.from_user.id})
        already = False
        if user and str(prob["_id"]) in user.get("solved", []):
            already = True
        if not already:
            await award_xp(cq.from_user.id, prob.get("xp",50), str(prob["_id"]))
            await cq.answer("✅ Correct! XP awarded.", show_alert=True)
            await cq.message.edit_text(cq.message.text + f"\n\n✅ Answer: Correct — {cq.from_user.mention} awarded {prob.get('xp',50)} XP", parse_mode="markdown")
        else:
            await cq.answer("✅ Correct — but you already solved this problem before.", show_alert=True)
    else:
        await cq.answer("❌ Incorrect. Try next!", show_alert=True)
        await cq.message.edit_text(cq.message.text + f"\n\n❌ Incorrect answer by {cq.from_user.mention}", parse_mode="markdown")

@app.on_callback_query(filters.regex(r"^next\|"))
async def cb_next(_, cq: CallbackQuery):
    # serve next problem (random) when user presses Next
    _, pid = cq.data.split("|",1)
    p = await random_problem()
    if not p:
        return await cq.answer("No other problems available.", show_alert=True)
    # update last served mapping for this chat
    await meta_col.update_one({"_id":"last_served"}, {"$set": {str(cq.message.chat.id): str(p["_id"])}}, upsert=True)
    if p["type"] == "mcq":
        text = f"*{p.get('title')}*\n\n{p.get('statement')}\n\nXP: {p.get('xp',50)}"
        await cq.message.edit_text(text, reply_markup=mcq_keyboard(str(p["_id"]), p["choices"]), parse_mode="markdown")
    else:
        text = f"*{p.get('title')}*\n\n{p.get('statement')}\n\nXP: {p.get('xp',100)}\n\nTo submit: reply to this message with /submitcode"
        await cq.message.edit_text(text, reply_markup=code_problem_keyboard(str(p["_id"])), parse_mode="markdown")
    await cq.answer()

# Review callbacks
@app.on_callback_query(filters.regex(r"^review_(accept|reject)(?:_note)?\|"))
async def cb_review_decision(_, cq: CallbackQuery):
    data = cq.data  # e.g. review_accept|<sid> or review_reject_note|<sid>
    parts = data.split("|")
    action_part = parts[0]  # review_accept or review_reject_note
    sid = parts[1]
    try:
        sub = await subs_col.find_one({"_id": ObjectId(sid)})
    except:
        return await cq.answer("Submission not found.", show_alert=True)
    if not sub:
        return await cq.answer("Submission not found.", show_alert=True)

    # if action expects a note we ask admin to reply to this callback with a message containing the note
    if action_part.endswith("_note"):
        # Record that admin intends to add note; we store temporary meta mapping admin->submission
        await meta_col.update_one({"_id":"pending_notes"}, {"$set": {str(cq.from_user.id): sid}}, upsert=True)
        return await cq.answer("Please reply to this chat with your note. The next message you send will be used as review note.", show_alert=True)

    # Immediate accept/reject without note
    if action_part.startswith("review_accept"):
        # accept
        await subs_col.update_one({"_id": ObjectId(sid)}, {"$set": {"status":"accepted", "reviewer": cq.from_user.id, "reviewed_at": datetime.utcnow()}})
        # award xp
        prob_id = sub.get("problem_id")
        prob = await problems_col.find_one({"_id": ObjectId(prob_id)}) if prob_id else None
        xp = prob.get("xp",100) if prob else 100
        await award_xp(sub.get("user_id"), xp, prob_id)
        # notify user
        try:
            await app.send_message(sub.get("user_id"), f"✅ Your submission for *{sub.get('problem_title')}* was *ACCEPTED*! You gained {xp} XP.", parse_mode="markdown")
        except Exception:
            pass
        await cq.answer("Submission accepted and XP awarded.", show_alert=True)
    else:
        # reject
        await subs_col.update_one({"_id": ObjectId(sid)}, {"$set": {"status":"rejected", "reviewer": cq.from_user.id, "reviewed_at": datetime.utcnow()}})
        try:
            await app.send_message(sub.get("user_id"), f"❌ Your submission for *{sub.get('problem_title')}* was *REJECTED*.", parse_mode="markdown")
        except Exception:
            pass
        await cq.answer("Submission rejected.", show_alert=True)

# Handle admin note messages (admin replies with note after selecting review_accept_note/reject_note)
@app.on_message(filters.private & filters.user(ADMIN_IDS))
async def admin_note_handler(_, m: Message):
    # check meta if admin has a pending note
    doc = await meta_col.find_one({"_id":"pending_notes"})
    if not doc:
        return
    mapping = doc or {}
    sid = mapping.get(str(m.from_user.id))
    if not sid:
        return
    note_text = m.text or ""
    # find submission
    try:
        sub = await subs_col.find_one({"_id": ObjectId(sid)})
    except:
        sub = None
    if not sub:
        await m.reply_text("Submission not found.")
        # cleanup pending note
        await meta_col.update_one({"_id":"pending_notes"}, {"$unset": {str(m.from_user.id): ""}})
        return
    # admin must decide whether accept or reject in previous callback; we cannot deduce action type here.
    # So we store the note and ask admin to run /finalize_review <submission_id> accept|reject
    # store note in meta temp storage
    await meta_col.update_one({"_id":"review_notes"}, {"$set": {sid: note_text}}, upsert=True)
    await m.reply_text(f"Note saved for submission {sid}.\nNow run `/finalize_review {sid} accept` or `/finalize_review {sid} reject` to complete review.")

# Admin finalize_review command to accept/reject with note
@app.on_message(filters.command("finalize_review") & filters.user(ADMIN_IDS))
async def cmd_finalize_review(_, m: Message):
    # usage: /finalize_review <submission_id> accept|reject
    if len(m.command) < 3:
        return await m.reply_text("Usage: /finalize_review <submission_id> accept|reject")
    sid = m.command[1]
    verdict = m.command[2].lower()
    try:
        sub = await subs_col.find_one({"_id": ObjectId(sid)})
    except:
        sub = None
    if not sub:
        return await m.reply_text("Submission not found.")
    note_doc = await meta_col.find_one({"_id":"review_notes"}) or {}
    note_text = note_doc.get(sid)
    if verdict == "accept":
        await subs_col.update_one({"_id": ObjectId(sid)}, {"$set": {"status":"accepted", "reviewer": m.from_user.id, "review_note": note_text, "reviewed_at": datetime.utcnow()}})
        prob = await problems_col.find_one({"_id": ObjectId(sub.get("problem_id"))})
        xp = prob.get("xp",100) if prob else 100
        await award_xp(sub.get("user_id"), xp, sub.get("problem_id"))
        try:
            await app.send_message(sub.get("user_id"), f"✅ Your submission for *{sub.get('problem_title')}* was *ACCEPTED*! You gained {xp} XP.\n\nNote: {note_text or 'No note.'}", parse_mode="markdown")
        except Exception:
            pass
        await m.reply_text("Submission accepted and user awarded XP.")
    elif verdict == "reject":
        await subs_col.update_one({"_id": ObjectId(sid)}, {"$set": {"status":"rejected", "reviewer": m.from_user.id, "review_note": note_text, "reviewed_at": datetime.utcnow()}})
        try:
            await app.send_message(sub.get("user_id"), f"❌ Your submission for *{sub.get('problem_title')}* was *REJECTED*.\n\nNote: {note_text or 'No note.'}", parse_mode="markdown")
        except Exception:
            pass
        await m.reply_text("Submission rejected.")
    else:
        await m.reply_text("Unknown verdict — use accept or reject.")
    # cleanup saved note
    await meta_col.update_one({"_id":"review_notes"}, {"$unset": {sid: ""}})

